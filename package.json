{
  "name": "discode",
  "version": "1.1.0",
  "description": "Discord-native agent interface for local coding tools, model providers, and project workspaces.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.8",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morefeinn/discode.git"
  },
  "bugs": {
    "url": "https://github.com/morefeinn/discode/issues"
  },
  "homepage": "https://github.com/morefeinn/discode#readme",
  "bin": {
    "codex-bot": "./bin/codex-bot.mjs",
    "discode": "./bin/codex-bot.mjs"
  },
  "scripts": {
    "setup": "bun bin/codex-bot.mjs setup",
    "start": "bun src/index.ts",
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --packages external",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "gifenc": "^1.0.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "typescript": "^5.9.3"
  }
}
